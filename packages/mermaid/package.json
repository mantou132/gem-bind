{
  "name": "@gem-bind/mermaid",
  "version": "0.0.3",
  "description": "Mermaid diagram Gem element",
  "keywords": [
    "gem",
    "mermaid",
    "diagram"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:type && swc --strip-leading-paths src --out-dir ./dist",
    "build:type": "tsc --emitDeclarationOnly --outDir ./dist",
    "start": "concurrently \"swc --strip-leading-paths src --out-dir ./dist --watch\" \"pnpm build:type --watch\"",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@mantou/gem": "^2.0.0",
    "duoyun-ui": "^2.0.0"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@gem-bind/config": "^2.1.1",
    "@mantou/gem": "^2.2.11",
    "duoyun-ui": "^2.2.13"
  },
  "author": "mantou132",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantou132/gem-bind.git",
    "directory": "packages/mermaid"
  },
  "bugs": {
    "url": "https://github.com/mantou132/gem-bind/issues"
  },
  "homepage": "https://github.com/mantou132/gem-bind#readme"
}
