{
  "name": "@gem-bind/latex",
  "version": "0.0.2",
  "description": "LaTeX Gem element powered by KaTeX",
  "keywords": [
    "gem",
    "latex",
    "katex",
    "math"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:type && swc --strip-leading-paths src --out-dir ./dist",
    "build:type": "tsc --emitDeclarationOnly --outDir ./dist",
    "start": "concurrently \"swc --strip-leading-paths src --out-dir ./dist --watch\" \"pnpm build:type --watch\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@mantou/gem": "^2.2.8",
    "@swc/helpers": "^0.5.23",
    "duoyun-ui": "^2.2.3",
    "katex": "^0.18.4"
  },
  "devDependencies": {
    "@gem-bind/config": "^2.1.1"
  },
  "author": "mantou132",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantou132/gem-bind.git",
    "directory": "packages/latex"
  },
  "bugs": {
    "url": "https://github.com/mantou132/gem-bind/issues"
  },
  "homepage": "https://github.com/mantou132/gem-bind#readme"
}
