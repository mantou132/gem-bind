{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "target": "es2024",
    "parser": { "syntax": "typescript", "decorators": true },
    "transform": { "decoratorVersion": "2023-11" },
    "externalHelpers": true,
    "experimental": {
      "runPluginFirst": true,
      "plugins": [
        [
          "swc-plugin-gem",
          {
            "autoImport": {
              "extends": "gem",
              "members": {
                "@mantou/gem/helper/theme": ["createDecoratorTheme"]
              }
            },
            "autoImportDts": "src/types.ts"
          }
        ]
      ]
    }
  }
}
